module calculator (
    input  [3:0] A,
    input  [3:0] B,
    input  [1:0] operation,
    output reg [7:0] result
);

always @(*) begin
    case (operation)

        2'b00: result = A + B;  // Addition
        2'b01: result = A - B;  // Subtraction
        2'b10: result = A * B;  // Multiplication
        2'b11: result = A / B;  // Division

        default: result = 8'b0;

    endcase
end

endmodule
| Operation | Function       |
| --------- | -------------- |
| `00`      | Addition       |
| `01`      | Subtraction    |
| `10`      | Multiplication |
| `11`      | Division       |
